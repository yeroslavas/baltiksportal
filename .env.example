# Supabase — find these in your project's API settings:
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. NEVER expose this to the browser / commit it.
# (Settings > API > Project API keys > service_role)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Comma-separated list of emails allowed into /admin
ADMIN_EMAILS=yero@baltiksbagel.com
