# Copy this file to .env.local and fill in real values. .env.local is gitignored.
# The same variables are set in Vercel (Project Settings → Environment Variables)
# for production. Grouped by subsystem; a few are optional (noted inline).

# ── Supabase ────────────────────────────────────────────────────────────────
# Find these under Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. NEVER expose this to the browser / commit it. Powers admin
# reads/writes + scripts (bypasses RLS). (Settings → API → service_role key)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ── Admin access ────────────────────────────────────────────────────────────
# Comma-separated emails allowed into /admin (case-insensitive).
# Add a sub-admin's email here to give them full admin access EXCEPT Utilities.
ADMIN_EMAILS=yero@baltiksbagel.com
# Subset of ADMIN_EMAILS who can ALSO access Utilities (the master admin[s]).
# If unset, every admin is treated as super — so set this when you add a
# sub-admin, otherwise they'd get Utilities access too.
SUPER_ADMIN_EMAILS=yero@baltiksbagel.com

# ── Stripe (payments) ───────────────────────────────────────────────────────
# Selects which key set is used. Anything other than "live" means test mode.
# Production MUST be "live" for real payments to reach your account.
STRIPE_MODE=test
# Dashboard → Developers → API keys. Test keys start sk_test_, live sk_live_.
# Only the key for the active STRIPE_MODE is required; keep both to flip modes.
STRIPE_SECRET_KEY_TEST=sk_test_...
STRIPE_SECRET_KEY_LIVE=sk_live_...
# Webhook signing secrets (whsec_...), one per mode.
#  • TEST (local dev): from the Stripe CLI —
#      stripe login
#      stripe listen --forward-to localhost:3000/api/stripe/webhook
#  • LIVE (production): from the live-mode webhook endpoint you create in the
#    Dashboard pointing at https://<your-domain>/api/stripe/webhook, subscribed
#    to checkout.session.completed / .async_payment_succeeded /
#    .async_payment_failed / .expired and payment_intent.succeeded / .payment_failed.
STRIPE_WEBHOOK_SECRET_TEST=whsec_...
STRIPE_WEBHOOK_SECRET_LIVE=whsec_...

# ── Cron ────────────────────────────────────────────────────────────────────
# Shared secret guarding the /api/cron/* routes (standing orders, overdue
# invoices, order status, autopay, payment reconciliation, sheets sync). Vercel
# Cron sends it as "Authorization: Bearer <CRON_SECRET>"; routes 401 without it.
CRON_SECRET=some-long-random-string

# ── Google Sheets export (optional) ─────────────────────────────────────────
# Pushes the production order export to a Sheet via its bound Apps Script web
# app. Both URL + SECRET must be set to enable it; unset = feature disabled.
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/.../exec
GOOGLE_SHEETS_WEBHOOK_SECRET=shared-secret-matching-the-apps-script
# Data tab name in the sheet (defaults to "Orders" if unset).
GOOGLE_SHEETS_TAB=Orders

# ── Resend email (optional) ─────────────────────────────────────────────────
# Transactional email: payment receipts + admin alerts (failed ACH / auto-pay).
# Unset = all such email is silently skipped (payment flows still work).
# (Self-service password reset uses Supabase Auth's own email, not Resend.)
RESEND_API_KEY=re_...
# Verified sender. Resend's onboarding@resend.dev works for early testing
# (delivers only to the Resend account owner).
RESEND_FROM=Baltiks Bagel <noreply@your-domain.com>
